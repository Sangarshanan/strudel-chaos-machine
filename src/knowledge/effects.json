      {
        "name": "tremolosync",
        "range": [
          2,
          10
        ],
        "desc": "Tremolo rate Hz."
      }
    ],
    "pitch": [
      {
        "name": "note",
        "desc": "Pitch as note names or MIDI numbers."
      },
      {
        "name": "n",
        "desc": "Sample index OR scale degree."
      },
      {
        "name": "scale",
        "desc": "Apply a named scale, e.g. \"C:minor\"."
      },
      {
        "name": "transpose",
        "desc": "Transpose by semitones."
      },
      {
        "name": "octave",
        "desc": "Octave shift."
      }
    ],
    "sound_choice": [
      {
        "name": "s",
        "desc": "Sound selector (drum/sample/synth name)."
      },
      {
        "name": "sound",
        "desc": "Alias for s()."
      },
      {
        "name": "bank",
        "desc": "Set drum bank, e.g. \"RolandTR909\"."
      }
    ],
    "pattern_transforms": [
      {
        "name": "fast",
        "desc": "Speed pattern up by factor."
      },
      {
        "name": "slow",
        "desc": "Slow pattern down by factor."
      },
      {
        "name": "rev",
        "desc": "Reverse the pattern."
      },
      {
        "name": "palindrome",
        "desc": "Forward then reverse."
      },
      {
        "name": "iter",
        "desc": "Iterate through subdivisions."
      },
      {
        "name": "every",
        "desc": ".every(n, fn) apply fn on every n-th cycle."
      },
      {
        "name": "sometimes",
        "desc": "50% chance to apply fn."
      },
      {
        "name": "often",
        "desc": "75% chance."
      },
      {
        "name": "rarely",
        "desc": "25% chance."
      },
      {
        "name": "degrade",
        "desc": "Randomly drop events."
      },
      {
        "name": "degradeBy",
        "desc": "Drop events with probability."
      },
      {
        "name": "jux",
        "desc": "Pan-split with transformed copy."
      },
      {
        "name": "stack",
        "desc": "Layer patterns in parallel."
      },
      {
        "name": "layer",
        "desc": "Apply list of functions in parallel."
      },
      {
        "name": "struct",
        "desc": "Apply a binary structure pattern."
      },
      {
        "name": "mask",
        "desc": "Mask events with a binary pattern."
      }
    ]
  }
}