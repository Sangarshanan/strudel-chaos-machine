      {
        "name": "hpf",
        "range": [
          20,
          20000
        ],
        "desc": "High-pass cutoff Hz."
      },
      {
        "name": "bpf",
        "range": [
          20,
          20000
        ],
        "desc": "Band-pass cutoff Hz."
      },
      {
        "name": "lpq",
        "range": [
          0,
          50
        ],
        "desc": "Low-pass resonance."
      },
      {
        "name": "hpq",
        "range": [
          0,
          50
        ],
        "desc": "High-pass resonance."
      },
      {
        "name": "bpq",
        "range": [
          0,
          50
        ],
        "desc": "Band-pass resonance."
      },
      {
        "name": "lpenv",
        "desc": "LPF envelope amount."
      },
      {
        "name": "hpenv",
        "desc": "HPF envelope amount."
      },
      {
        "name": "bpenv",
        "desc": "BPF envelope amount."
      }
    ],
