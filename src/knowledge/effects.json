      {
        "name": "distort",
        "range": [
          0,
          1
        ],
        "desc": "Wave-shaping distortion."
      },
      {
        "name": "coarse",
        "range": [
          1,
          32
        ],
        "desc": "Sample rate reduction."
      },
      {
        "name": "shape",
        "range": [
          0,
          1
        ],
        "desc": "Wave-shape amount."
