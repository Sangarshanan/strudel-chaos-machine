      {
        "name": "attack",
        "range": [
          0,
          4
        ],
        "desc": "Attack seconds."
      },
      {
        "name": "decay",
        "range": [
          0,
          4
        ],
        "desc": "Decay seconds."
      },
      {
        "name": "sustain",
        "range": [
          0,
          1
        ],
        "desc": "Sustain level."
      },
      {
        "name": "release",
        "range": [
          0,
          4
        ],
        "desc": "Release seconds."
      },
      {
        "name": "adsr",
        "desc": "Shorthand: \"a:d:s:r\"."
      }
    ],
