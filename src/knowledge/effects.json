{
  "version": 1,
  "source": "Strudel API reference",
  "categories": {
    "amplitude": [
      {
        "name": "gain",
        "range": [
          0,
          2
        ],
        "default": 1,
        "desc": "Linear volume."
      },
      {
        "name": "velocity",
        "range": [
          0,
          1
        ],
        "default": 1,
        "desc": "MIDI-like velocity."
      }
    ],
    "panning": [
      {
        "name": "pan",
        "range": [
          0,
          1
        ],
        "default": 0.5,
        "desc": "0=L, 1=R."
      }
    ],
    "playback": [
      {
        "name": "speed",
        "range": [
          -4,
          4
        ],
        "default": 1,
        "desc": "Sample playback speed; negative reverses."
      },
      {
        "name": "begin",
        "range": [
          0,
          1
        ],
        "desc": "Sample start position."
      },
      {
        "name": "end",
        "range": [
          0,
          1
        ],
        "desc": "Sample end position."
      },
      {
        "name": "clip",
        "desc": "Clip note to fraction of cycle."
      },
      {
        "name": "ply",
        "desc": "Repeat each event n times."
      },
      {
        "name": "chunk",
        "desc": "Apply a function to a chunk of the pattern."
      },
      {
        "name": "striate",
        "desc": "Slice and reorder a sample."
      },
      {
        "name": "bite",
        "desc": "Take a section of the pattern."
      }
    ],
    "filters": [
      {
        "name": "lpf",
        "range": [
          20,
          20000
        ],
        "desc": "Low-pass cutoff Hz."
